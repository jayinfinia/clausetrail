# Copy this file to .env (it is git-ignored) and uncomment what you need.
# The launchers and scripts/start.py read .env automatically; Docker Compose reads it too.

# Cited answers written by Claude, for the FICTIONAL demo only (refused in --private mode).
# QA_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_QA_MODEL=claude-sonnet-5-5
# QA_DAILY_LIMIT=200            # model calls per day; each question uses about 2 to 4

# Docker Compose: replace with a random URL-safe value, e.g. python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=replace-with-random-url-safe-value
# Local default: SQLite under .local, same SQLAlchemy models as PostgreSQL.
# DEMO_MODE=true
# APP_ORIGIN=http://localhost:8000
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_URL=http://127.0.0.1:11434
# Optional question-answering model (separate from extraction):
# QA_MODEL=qwen2.5:7b
# QA_OLLAMA_URL=http://127.0.0.1:11434
